<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="1200" height="380" viewBox="0 0 1200 380">
<defs>
  <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#050B16"/><stop offset="0.6" stop-color="#07182A"/><stop offset="1" stop-color="#063B4A"/>
  </linearGradient>
  <radialGradient id="glow" cx="0.85" cy="0.2" r="0.6">
    <stop offset="0" stop-color="#00D9A3" stop-opacity="0.35"/><stop offset="1" stop-color="#00D9A3" stop-opacity="0"/>
  </radialGradient>
  <pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse">
    <path d="M32 0H0V32" fill="none" stroke="#00D9A3" stroke-opacity="0.06"/>
  </pattern>
  <clipPath id="round"><rect width="1200" height="380" rx="22"/></clipPath>
  <clipPath id="face"><circle cx="190" cy="190" r="118"/></clipPath>
  <style>
    .f{font-family:'Segoe UI',Inter,system-ui,-apple-system,Helvetica,Arial,sans-serif}
    .in{animation:in .8s ease-out backwards}
    .d1{animation-delay:.1s} .d2{animation-delay:.3s} .d3{animation-delay:.5s} .d4{animation-delay:.7s}
    @keyframes in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
    .ring{animation:pulse 3s ease-in-out infinite}
    @keyframes pulse{50%{stroke-opacity:.35}}
    .cur{animation:blink 1s step-end infinite}
    @keyframes blink{50%{opacity:0}}
    .dot{animation:pulse2 1.6s ease-in-out infinite}
    @keyframes pulse2{50%{opacity:.3}}
  </style>
</defs>
<g clip-path="url(#round)">
  <rect width="1200" height="380" fill="url(#bg)"/>
  <rect width="1200" height="380" fill="url(#grid)"/>
  <rect width="1200" height="380" fill="url(#glow)"/>
  <path d="M0 330 C 300 290, 600 380, 1200 300 L1200 380 L0 380Z" fill="#00D9A3" fill-opacity="0.08"/>
  <path d="M0 350 C 350 320, 700 390, 1200 330 L1200 380 L0 380Z" fill="#00D9A3" fill-opacity="0.10"/>

  <!-- portrait -->
  <circle cx="190" cy="190" r="132" fill="none" stroke="#00D9A3" stroke-width="3" stroke-opacity="0.25"/>
  <circle class="ring" cx="190" cy="190" r="124" fill="none" stroke="#00E5FF" stroke-width="6" stroke-opacity="0.9"/>
  <image clip-path="url(#face)" x="72" y="72" width="236" height="236" xlink:href="data:image/jpeg;base64,"/>

  <!-- text -->
  <text class="f in d1" x="360" y="96" fill="#E6EDF3" font-size="28" font-weight="500">Hi there, I'm</text>
  <text class="f in d2" x="358" y="168" fill="#FFFFFF" font-size="72" font-weight="800" letter-spacing="-1">Dhilipkumar <tspan fill="#00D9A3">P</tspan></text>
  <text class="f in d3" x="360" y="210" fill="#C9D1D9" font-size="22" font-weight="600">MERN Stack Developer  ·  Full-Stack Engineer  ·  AI &amp; NLP Enthusiast</text>
  <text class="f in d3" x="360" y="248" fill="#00D9A3" font-size="21" font-style="italic" font-weight="600">Building scalable web applications<tspan class="cur">_</tspan></text>

  <!-- pills -->
  <g class="f in d4" font-size="16" font-weight="600">
    <rect x="360" y="278" width="206" height="38" rx="19" fill="#0B1F2E" stroke="#00D9A3" stroke-opacity="0.6"/>
    <circle cx="382" cy="297" r="6" fill="#00D9A3"/>
    <text x="398" y="303" fill="#E6EDF3">Focus: MERN Stack</text>
    <rect x="580" y="278" width="222" height="38" rx="19" fill="#0B1F2E" stroke="#F7B500" stroke-opacity="0.7"/>
    <circle cx="602" cy="297" r="6" fill="#F7B500"/>
    <text x="618" y="303" fill="#E6EDF3">Experience: 3+ Years</text>
    <rect x="816" y="278" width="164" height="38" rx="19" fill="#0B1F2E" stroke="#00C853" stroke-opacity="0.8"/>
    <circle class="dot" cx="838" cy="297" r="6" fill="#00E676"/>
    <text x="854" y="303" fill="#E6EDF3">Open to Work</text>
  </g>

  <!-- code icon -->
  <g class="in d4" transform="translate(1010 70)">
    <rect width="140" height="100" rx="14" fill="#0B1F2E" stroke="#00D9A3" stroke-opacity="0.5"/>
    <path d="M48 32 L28 50 L48 68 M92 32 L112 50 L92 68 M78 26 L62 74" fill="none" stroke="#00E5FF" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
</g>
</svg>
